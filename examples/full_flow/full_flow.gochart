statechart Simple {
	trigger Trigger1(int foo, float bar)
	trigger Trigger2()

	state StateA(default) {
		enter
		enter(Trigger1)

		exit(Trigger1)
		exit

		capture(Trigger1)

		state StateB {
			exit(Trigger1)

			transition Trigger1 > StateC
		}

		state StateC {
			enter
			enter(Trigger1)
		}
	}
}
