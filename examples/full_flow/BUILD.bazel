load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//:defs.bzl", "generate_gochart_cpp")

cc_binary(
    name = "full_flow",
    srcs = [
        "main.cpp",
    ],

    copts = [
        "/std:c++20",
    ],
    includes = [
        "statechart.generated.h",
    ],
    deps = [
      ":gochart",
    ],
)

generate_gochart_cpp(
	name = "gochart",
  src = "full_flow.gochart",
  header_out = "statechart.generated.h",
  cpp_out = "statechart.generated.cpp",
	copts = [
		"/std:c++20",
	],
)
