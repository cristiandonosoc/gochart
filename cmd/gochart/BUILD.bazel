load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "gochart_lib",
    srcs = [
        "backend.go",
        "main.go",
        "unreal.go",
    ],
    importpath = "github.com/cristiandonosoc/gochart/cmd/gochart",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/files",
        "//internal/option",
        "//pkg/backend",
        "//pkg/backend/cpp",
        "//pkg/frontend",
        "//pkg/gochart",
        "//pkg/unreal",
        "@com_github_urfave_cli_v2//:cli",
    ],
)

go_binary(
    name = "gochart",
    embed = [":gochart_lib"],
    visibility = ["//visibility:public"],
)
