gochart Parallel {
	trigger ActivateActuator(test::EActuatorType actuator, bool activate)

	trigger StartSpawning()
	trigger Spawned()
	trigger SpawningActuatorDone()

	trigger TargetAcquired()
	trigger TargetConfirmed()
	trigger TargetDispatched()

	trigger Update(float dt)

	state Root(parallel) {
		exit

		state MainActuator {
			exit

			transition TargetDispatched > Attack

			state Idle {
				transition StartSpawning > WaitingOnSpawning
			}

			state WaitingOnSpawning {
				transition SpawningActuatorDone > Ready
			}

			state Ready {
				enter
			}

			state Attack {
				enter
				exit
			}
		}

		state SpawnActuator {
			exit

			state SpawnInactive {
				transition ActivateActuator > SpawnActive if {
					return actuator == test::EActuatorType::Spawn && activate;
				}
			}

			state SpawnActive {
				exit

				transition ActivateActuator > SpawnInactive if {
					return actuator == test::EActuatorType::Spawn && !activate;
				}

				state SpawnIdle {
					transition StartSpawning > SpawnInProgress
				}

				state SpawnInProgress {
					transition Spawned > SpawnDone
				}

				state SpawnDone {
					enter

					transition null > SpawnIdle do {
						gochart.TriggerSpawningActuatorDone();
					}
				}
			}
		}

		state AimingActuator {
			enter
			exit

			state AimingInactive {
				transition ActivateActuator > AimingActive if {
					return actuator == test::EActuatorType::Aiming && activate;
				}
			}

			state AimingActive(parallel) {
				transition ActivateActuator > AimingInactive if {
					return actuator == test::EActuatorType::Aiming && !activate;
				}

				enter
				exit

				state AimingSearcher {
					capture Update
				}

				state AimingAnalyzer {
					enter
					exit

					capture TargetAcquired
				}

				state AimingDispatcher {
					exit

					state AimingDispatcherIdle {
						transition TargetConfirmed > AimingDispatcherDispatching
					}

					state AimingDispatcherDispatching {
						transition TargetDispatched > AimingDispatcherIdle
					}
				}
			}
		}
	}
}
