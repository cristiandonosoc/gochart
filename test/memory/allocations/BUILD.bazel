load("//:defs.bzl", "generate_gochart_cpp")

cc_binary(
    name = "allocations",
    srcs = ["allocations.cpp"],
    deps = [
        ":gochart_parallel",
        ":gochart_simple",
    ],
)

cc_test(
    name = "allocations_test",
    size = "small",
    srcs = ["allocations_test.cpp"],
    deps = [
        ":gochart_parallel",
        ":gochart_simple",
        "//test/support/cpp:test_support",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_library(
    name = "gochart_simple",
    hdrs = [
        "simple.gochart.declare.h",
        "simple.gochart.define.h",
        "simple.gochart.forward_declare.h",
    ],
    include_prefix = ".",  # Add -I of dependencies.
    deps = [":gen_gochart_simple"],
)

generate_gochart_cpp(
    name = "gen_gochart_simple",
    src = "simple.gochart",
    file_prefix = "simple",
)

cc_library(
    name = "gochart_parallel",
    hdrs = [
        "parallel.gochart.declare.h",
        "parallel.gochart.define.h",
        "parallel.gochart.forward_declare.h",
    ],
    include_prefix = ".",  # Add -I of dependencies.
    deps = [":gen_gochart_parallel"],
)

generate_gochart_cpp(
    name = "gen_gochart_parallel",
    src = "parallel.gochart",
    file_prefix = "parallel",
)
