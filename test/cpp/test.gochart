statechart Door {
	trigger Update(bool tick)


	trigger ActivateDoorActuator(bool active)
	trigger ToggleDoor(bool open, bool fast)
	trigger DoorMovingDone(bool opened)

	state Door
	{
		capture Update

		state DoorInactive
		{
			transition ActivateDoorActuator > DoorActive

			capture Update
		}

		state DoorActive
		{
			transition ActivateDoorActuator > DoorInactive

			state DoorOpened
			{
				transition ToggleDoor > DoorMoving

				capture Update if { tick }
			}

			state DoorMoving
			{
				enter ToggleDoor

				transition DoorMovingDone > DoorClosed
			}

			state DoorClosed
			{
				transition ToggleDoor > DoorMoving
			}
		}
	}
}
