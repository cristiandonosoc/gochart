// This is a comment
statechart Door {
	trigger Update(bool tick)		// This is another comment

	trigger ActivateDoorActuator(bool active)
	trigger ToggleDoor(bool open, bool fast)
	trigger DoorMovingDone(bool opened)

	state Door
	{
		capture Update

		state DoorInactive
		{
			transition ActivateDoorActuator > DoorActive if {
				return active;
			} do {
					owner.ActionFunction(active);
			}

			capture Update
		}

		state DoorActive
		{
			transition ActivateDoorActuator > DoorInactive if { return !active; }

			state DoorOpened
			{
				transition ToggleDoor > DoorMoving

				capture Update if { return tick; }
			}

			state DoorMoving
			{
				enter ToggleDoor

				transition DoorMovingDone > DoorClosed
			}

			state DoorClosed
			{
				transition ToggleDoor > DoorMoving
			}
		}
	}
}
