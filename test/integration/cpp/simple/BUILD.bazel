load("//:defs.bzl", "generate_gochart_cpp")

cc_test(
    name = "simple_test",
    size = "small",
    srcs = ["simple_test.cpp"],
    deps = [
        ":gochart",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_library(
    name = "gochart",
    srcs = ["statechart.generated.cpp"],
    hdrs = ["statechart.generated.h"],
    include_prefix = ".",  # Add -I of dependencies.
    deps = [":gen_gochart"],
)

generate_gochart_cpp(
    name = "gen_gochart",
    src = "simple.gochart",
    cpp_out = "statechart.generated.cpp",
    header_out = "statechart.generated.h",
)
