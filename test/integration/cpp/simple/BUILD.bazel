load("//:defs.bzl", "generate_gochart_cpp")

cc_test(
    name = "simple_test",
    size = "small",
    srcs = ["simple_test.cpp"],
    deps = [
        ":gochart",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_library(
    name = "gochart",
    hdrs = [
        "simple.declare.h",
        "simple.define.h",
        "simple.forward_declare.h",
    ],
    include_prefix = ".",  # Add -I of dependencies.
    deps = [":gen_gochart"],
)

generate_gochart_cpp(
    name = "gen_gochart",
    src = "simple.gochart",
    file_prefix = "simple",
)

