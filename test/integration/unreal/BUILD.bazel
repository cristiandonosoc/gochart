load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "unreal",
    srcs = ["helpers.go"],
    importpath = "github.com/cristiandonosoc/gochart/test/integration/unreal",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/backend/common",
        "//pkg/backend/unreal",
        "@com_github_cristiandonosoc_golib//pkg/files",
