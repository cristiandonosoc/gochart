go_test(
    name = "unreal_test",
    srcs = ["unreal_test.go"],
    data = glob(["testdata/**"]),
    deps = [
        "//internal/build",
        "//internal/option",
        "//pkg/backend/unreal",
        "@com_github_cristiandonosoc_golib//pkg/test_support",
        "@com_github_cristiandonosoc_gunreal//pkg/unreal",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
