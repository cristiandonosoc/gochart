gochart GochartTest(parallel)
{
    trigger ToggleActuator(EActuatorType actuator)
    trigger Update(float dt)

    state MainActuator {
        capture Update
    }

    state TranslationActuator {
        state TranslationInactive {
            transition ToggleActuator > TranslationActive if {
                return actuator == EActuatorType::Translation;
            }
        }

        state TranslationActive {
            enter

            capture Update

            transition ToggleActuator > TranslationInactive if {
                return actuator == EActuatorType::Translation;
            }
        }
    }

    state RotationActuator {
        state RotationInactive {
            transition ToggleActuator > RotationActive if {
                return actuator == EActuatorType::Rotation;
            }
        }

        state RotationActive {
            enter
            capture Update

            transition ToggleActuator > RotationInactive if {
                return actuator == EActuatorType::Rotation;
            }
        }
    }

    state ScaleActuator {
        state ScaleInactive {
            transition ToggleActuator > ScaleActive if {
                return actuator == EActuatorType::Scale;
            }
        }

        state ScaleActive {
            enter
            capture Update

            transition ToggleActuator > ScaleInactive if {
                return actuator == EActuatorType::Scale;
            }
        }
    }
}
