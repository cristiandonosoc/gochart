###############################################################################
# Gochart's own build still uses WORKSPACE (Bazel 6, where Bzlmod is off by default).
#
# This module definition is for Bzlmod projects that depend on gochart, so they can build the tool
# and use the rules in defs.bzl:
#
#     bazel_dep(name = "gochart", version = "0.0.0")
#     git_override(module_name = "gochart", remote = "...", commit = "...")
#
#     load("@gochart//:defs.bzl", "generate_gochart_rust")
###############################################################################

module(
    name = "gochart",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.50.1", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.39.1", repo_name = "bazel_gazelle")
bazel_dep(name = "rules_pkg", version = "1.0.1")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_hashicorp_go_version",
    "com_github_masterminds_sprig_v3",
    "com_github_stretchr_testify",
    "com_github_urfave_cli_v2",
    "in_gopkg_yaml_v2",
    "org_golang_x_exp",
)
