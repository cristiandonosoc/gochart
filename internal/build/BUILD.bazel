load("@io_bazel_rules_go//go:def.bzl", "go_library")

go_library(
    name = "build",
    srcs = ["build.go"],
    importpath = "github.com/cristiandonosoc/gochart/internal/build",
    visibility = ["//:__subpackages__"],
    x_defs = {
        "github.com/cristiandonosoc/gochart/internal/build.GOCHART_VERSION": "{STABLE_GOCHART_VERSION}",
        "github.com/cristiandonosoc/gochart/internal/build.GOCHART_BUILD_TIME": "{FORMATTED_DATE}",
        "github.com/cristiandonosoc/gochart/internal/build.GOCHART_GIT_COMMIT": "{STABLE_GOCHART_GIT_COMMIT}",
    },
)
