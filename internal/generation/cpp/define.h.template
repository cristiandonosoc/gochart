bool IsChildOf(EState parent, EState child)
{
	EState target = GetParentState(child);
	while (target != EState::__Invalid__)
	{
		if (target == parent)
		{
			return true;
		}

		target = GetParentState(target);
	}

	return false;
}

bool IsLeafState(EState state)
{
	return GetChildCount(state) == 0;
}





