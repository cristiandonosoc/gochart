// Enter/Exit/Capture ------------------------------------------------------------------------------

template <typename T>
void Gochart<T>::EnterState(EState state, ETrigger trigger, const void* trigger_data)
{
    assert(state != EState::__Invalid__);
	size_t concurrent_group = {{$internal}}::GetConcurrentGroup(state);
	assert(concurrent_group < {{$internal}}::kConcurrentGroupCount);

	CurrentStates[concurrent_group] = state;

    // First we check for trigger specific reactions, as the default one will be called always.
    if (trigger != ETrigger::__Invalid__ && {{$internal}}::HasEnterReaction(state, trigger))
    {
        assert(trigger_data != nullptr);
        CallEnterReaction(state, trigger, trigger_data);
    }

    // Now we check if we need to also call the default enter reaction.
    if ({{$internal}}::HasEnterReaction(state, ETrigger::__Invalid__))
    {
        CallEnterReaction(state, ETrigger::__Invalid__, nullptr);
    }

	// If we have no more children, we know that we are the last enter of this route, so we can
	// evaluate leaf conditions.
	if ({{$internal}}::IsLeafState(state))
	{
		EvaluateLeafConditions(state, trigger, trigger_data);
	}
	else
	{
		// Now that we enter, we see if this state is concurrent and we need to enter the other
		// concurrent groups.
		if ({{$internal}}::GetIsConcurrent(state))
		{
			EvaluateConcurrentEnter(state, trigger, trigger_data);
		}
	}
}

template <typename T>
void Gochart<T>::EvaluateLeafConditions(EState state, ETrigger trigger, const void* trigger_data)
{
	switch (state)
	{
		{{- range $sc.States }}
		{{- $state := . }}
		{{- if gt (len $state.GetNullTransitions) 0 }}
		case EState::{{$state.Name}}:
		{
			assert({{$internal}}::GetChildCount(state) == 0);

			// We check the null transitions.
			bool handled = false;
			for (EState target_state : {{$internal}}::k{{$state.DisplayName}}NullTransitionTargetsArray)
			{
				// Check if this null transition has a condition.
				if (!{{$state.DisplayName}}_EvaluateNullTransitionConditionTargeting(target_state))
				{
					continue;
				}

				// Check if this null transition has an embedded action.
				{{$state.DisplayName}}_EvaluateNullTransitionActionTargeting(target_state);

				// Trigger immediatelly the transition.
				ProcessTransition(state, target_state, ETrigger::__Invalid__, nullptr);
				handled = true;
				break;
			}

			if (handled)
			{
				return;
			}

			break;
		}
		{{- end }}{{/* if gt (len $state.GetNullTransitions) 0 */}}
		{{- end }}{{/* range $sc.States */}}
		case EState::__Invalid__:
			GOCHART_DEBUG_BREAK;
			break;
		default:
			break;
	}
}

template <typename T>
void Gochart<T>::EvaluateConcurrentEnter(EState state, ETrigger trigger, const void* trigger_data)
{
	switch (state)
	{
		{{- range $sc.States }}
		{{- $state := . }}
		case EState::{{$state.Name}}:
		{
			{{- if $state.Concurrent }}
			for (EState child_state : {{$internal}}::k{{$state.DisplayName}}ChildrenArray)
			{
				// We enter the state and the we trigger a transition to follow the default enters.
				EnterState(child_state, trigger, trigger_data);
				ProcessTransition(child_state, child_state, trigger, trigger_data);
			}
			{{- else }}
			// State {{$state.Name}} is not concurrent. Nothing to do.
			GOCHART_DEBUG_BREAK;
			{{- end }}
			break;
		}
		{{- end }}{{/* range $sc.States */}}
		case EState::__Invalid__:
			GOCHART_DEBUG_BREAK;
			break;
	}
}

template <typename T>
void Gochart<T>::ExitState(EState state, ETrigger trigger, const void* trigger_data)
{
    assert(state != EState::__Invalid__);
	size_t concurrent_group = {{$internal}}::GetConcurrentGroup(state);
	assert(concurrent_group < {{$internal}}::kConcurrentGroupCount);

	// First we check if we need to exit any of the concurrent children.
	EvaluateConcurrentExit(state, trigger, trigger_data);

    // First we check for a trigger specific exit. Then we call the default exit.
    if (trigger != ETrigger::__Invalid__ && {{$internal}}::HasExitReaction(state, trigger))
    {
        assert(trigger_data != nullptr);
        CallExitReaction(state, trigger, trigger_data);
    }

    // Then we call the default exit.
    if ({{$internal}}::HasExitReaction(state, ETrigger::__Invalid__))
    {
        CallExitReaction(state, ETrigger::__Invalid__, nullptr);
    }

	// If the parent is concurrent, then we mark this concurrent group as invalid (stopped).
    EState parent = {{$internal}}::GetParentState(state);
	if (parent != EState::__Invalid__ && {{$internal}}::GetIsConcurrent(parent))
	{
		parent = EState::__Invalid__;
	}
	CurrentStates[concurrent_group] = parent;
}

template <typename T>
void Gochart<T>::EvaluateConcurrentExit(EState state, ETrigger trigger, const void* trigger_data)
{
	switch (state)
	{
		{{- range $sc.States }}
		{{- $state := . }}
		case EState::{{$state.Name}}:
		{
			{{- if $state.Concurrent }}
			// It it is a concurrent state, we need to close the concurrent children.
			// We iterate them in reverse order so that that they are closed from bottom of the file
			// upwards.
			auto& children = {{$internal}}::k{{$state.DisplayName}}ChildrenArray;
			for (auto it = children.rbegin(); it != children.rend(); it++)
			{
				// We issue a transition of this state out.
				ProcessTransition(*it, EState::__Invalid__, trigger, trigger_data);
			}
			{{- else }}
			// State {{$state.Name}} is not concurrent. Nothing to do.
			{{- end }}
			break;
		}
		{{- end }}{{/* range $sc.States */}}
		case EState::__Invalid__:
			GOCHART_DEBUG_BREAK;
			break;
	}
}

template <typename T>
void Gochart<T>::CaptureTrigger(EState state, ETrigger trigger, const void* trigger_data)
{
    assert(state != EState::__Invalid__);

    CallCaptureReaction(state, trigger, trigger_data);
}

// ProcessTriggerQueue -----------------------------------------------------------------------------

template <typename T>
void Gochart<T>::ProcessTriggerQueue()
{
    assert(GetFlag_Active());
    assert(ProcessingState != nullptr);

    assert(!GetFlag_ProcessingTriggerQueue());
    SetFlag_ProcessingTriggerQueue(true);

    while (true)
    {
        const auto& entry = ProcessingState->TriggerQueue.GetCurrent();
        if (entry.Trigger == ETrigger::__Invalid__)
        {
            break;
        }

        ProcessingState->CurrentTrigger = entry.Trigger;

		// We issue the trigger to all current active concurrent states.
		// The order of the concurrent groups is such that child groups will be processed first.
		for (EState state : CurrentStates)
		{
			if (state == EState::__Invalid__)
			{
				continue;
			}

			ProcessTrigger(state, entry);
		}

        ProcessingState->TriggerQueue.Dequeue();
    }

    ProcessingState->CurrentTrigger = ETrigger::__Invalid__;
    SetFlag_ProcessingTriggerQueue(false);
}

// Process Transition ------------------------------------------------------------------------------

template <typename T>
void Gochart<T>::ProcessTransition(EState from, EState to, ETrigger trigger, const void* trigger_data)
{
	// From the child state, we find the current active state of that concurrent group,
	// since that is the one we have to exit from.
	size_t concurrent_group = {{$internal}}::GetConcurrentGroup(from);
	assert(concurrent_group < {{$internal}}::kConcurrentGroupCount);

	if (EState active_state = CurrentStates[concurrent_group]; active_state != from)
	{
		assert({{$internal}}::IsChildOf(from, active_state));
		from = active_state;
	}

    // Get the default enter route from this state.
    {{$internal}}::Route route;
    {{$internal}}::Route::Compute(from, to, &route);

    // We go over all the exit states for this route.
    for (int i = 0; i < route.GetExitStatesSize(); i++)
    {
        EState state = route.GetExitStates()[i];
        ExitState(state, trigger, trigger_data);
    }

    // We now enter all the states needed for this route.
    for (int i = 0; i < route.GetEnterStatesSize(); i++)
    {
        EState state = route.GetEnterStates()[i];
        EnterState(state, trigger, trigger_data);
    }
}

