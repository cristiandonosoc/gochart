					{{$state.DisplayName}}_ExecuteActionFor{{$trigger.Name}}({{$callArgs}});
					{{- end }}{{/* if $transition.HasAction */}}

					ProcessTransition(EState::{{$transition.From.Name}},
											  EState::{{$transition.To.Name}},
											  ETrigger::{{$transition.Trigger.Name}},
											  &data);
					return true;
