// Route Implementation ----------------------------------------------------------------------------

Route::Route()
{
    // We ensure that the route are filled with invalid.
    for (size_t i = 0; i < kMaxRouteLength; i++)
    {
        EnterStates[i] = EState::__Invalid__;
        ExitStates[i] = EState::__Invalid__;
    }
}

void Route::AppendEnterState(EState enter)
{
    assert(EnterEnd < kMaxRouteLength);
    EnterStates[EnterEnd++] = enter;
}

void Route::AppendExitState(EState exit)
{
    assert(ExitEnd < kMaxRouteLength);
    ExitStates[ExitEnd++] = exit;
}

void Route::SwapEnterStates()
{
    // We swap the enter states in so they in the furthers from the |from| state first.
	std::reverse(EnterStates.begin(), EnterStates.begin() + EnterEnd);
}

void Route::AppendDefaultEnters(EState state, Route* out)
{
	// If the state is concurrent, there is no default enters to evaluate (it is somewhat similar to
	// a leaf state for this concurrent group).
	if ({{$internal}}::GetIsConcurrent(state))
	{
		return;
	}

    EState default_child = GetDefaultChild(state);
    while (default_child != EState::__Invalid__)
    {
        out->AppendEnterState(default_child);

		// If the child we just entered is concurrent, we don't continue iterating, as their enter
		// take care of continuing the enter of their respective child concurrent groups.
		if ({{$internal}}::GetIsConcurrent(default_child))
		{
			break;
		}

		// Otherwise we continue going down the default enter route.
        default_child = GetDefaultChild(default_child);
    }
}

void Route::AppendDefaultExits(EState state, Route* out)
{
	// We only add default exists until we either find an invalid parent (meaning that we got into
	// the root state, or we find a concurrent parent, which acts as the "root" of this concurrent
	// group.
	do {
		out->AppendExitState(state);
		state = GetParentState(state);
	} while (state != EState::__Invalid__ && !GetIsConcurrent(state));
}

void Route::Compute(EState from, EState to, Route* out)
{
    assert(from != EState::__Invalid__);

    // Special case of when we are just doing a route to the invalid state.
	// This is basically "exit the state as much as you can".
    // The main case is deactivating the statechart, in which we need to exit the whol state stack.
    if (to == EState::__Invalid__)
    {
        out->AppendDefaultExits(from, out);
        return;
    }

    EState original_to = to;

    // We need to find the common state between them.
    // Since they are not the same, first we go from the |from|, compare, and then we compare
    // from the |to|. If not equal then, repeat the process.
	//
	// By definition, the common state between them will be the parent concurrent state.
    while (from != to)
    {
        // Try to go up from the |from| side.
        if (EState from_parent = GetParentState(from); from_parent != EState::__Invalid__)
        {
            out->AppendExitState(from);
            from = from_parent;
        }

        // Now we pop the |to| side.
        if (EState to_parent = GetParentState(to); to_parent != EState::__Invalid__)
        {
            out->AppendEnterState(to);
            to = to_parent;
        }

        // At this point we're ready to try again.
    }

    // We need to reverse the valid enter states, as they are in the wrong order, given on how the
	// algorithm operates from the leaves up.
    out->SwapEnterStates();

    // Now it could be that the destination state is not a leaf state, so we get the default enters.
    out->AppendDefaultEnters(original_to, out);

}

// TriggerRingBufferQueue Implementation -----------------------------------------------------------

void TriggerRingBufferQueue::Enqueue({{$internal}}::TriggerEntry&& entry)
{
    assert(!IsFull());
    RingBuffer[WriteIndex] = std::move(entry);
    WriteIndex = (WriteIndex + 1) % kRingBufferSize;
}

void TriggerRingBufferQueue::Dequeue()
{
    assert(!IsEmpty());

    RingBuffer[ReadIndex] = {};  // Clear the entry.
    ReadIndex = (ReadIndex + 1) % kRingBufferSize ;
}

