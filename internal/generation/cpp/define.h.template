// TriggerRingBufferQueue keeps a queue of all the current triggers active at a given time.
// This is useful because triggers can be sent while handling other triggers, so we need a queue
// to be able to maitain the list of all sent triggers.
//
// TODO(cdc): This class is the same for each statechart class, so there is no need to generate
//            it over and over. Once we have a place to have common "gochart" things, we can
//            move this there.
class TriggerRingBufferQueue
{
public:
	// TODO(cdc): Make queue size configurable.
	static constexpr size_t kRingBufferSize = 16;

public:
	void Enqueue(TriggerEntry&& entry);
	void Dequeue();

	bool IsEmpty() const { return ReadIndex == WriteIndex; }
	bool IsFull() const { return ((WriteIndex + 1) % kRingBufferSize ) == ReadIndex; }

public:
	const TriggerEntry& GetCurrent() const { return RingBuffer[ReadIndex]; }

private:
	std::array<TriggerEntry, kRingBufferSize> RingBuffer;
	std::size_t ReadIndex = 0;
	std::size_t WriteIndex = 0;
};

struct TriggerProcessingState
{
	TriggerRingBufferQueue TriggerQueue;
	ETrigger CurrentTrigger = ETrigger::__Invalid__;
};

// Route ===============================

// Route is a helper class that represents the "path" between two states.
// It will hold the states that need to be exited first and then the states that will need to be
// entered after that.
//
// TODO(cdc): This class is the same for each statechart class, so there is no need to generate
//            it over and over. Once we have a place to have common "gochart" things, we can
//            move this there.
class Route
{
public:
	static constexpr size_t kMaxRouteLength = 32;

	// Compute figures out a route between any two states.
	// If |to| is invalid, it will figute out the exit route from the |from| state up out of the
	// root. This is useful in the deactivate case.
	//
	// In any other case (even if |from| == |to|), if the |to| state is not a leaf state (ie. it
	// has children), it will figure out the enter for the default childs correctly.
	static void Compute(EState from, EState to, Route* out);

public:
	Route();

public:
	void AppendEnterState(EState enter);
	void AppendExitState(EState exit);

	// For enter states, they are normally appended FILO, so they should be swapped so that they
	// can easily be iterated in the order that they are going to be entered.
	void SwapEnterStates();
	void AppendDefaultEnters(EState state, Route* out);
	void AppendDefaultExits(EState state, Route* out);

public:
	int GetEnterStatesSize() const { return EnterEnd; }
	const std::array<EState, kMaxRouteLength> GetEnterStates() const { return EnterStates; }

	int GetExitStatesSize() const { return ExitEnd; }
	const std::array<EState, kMaxRouteLength> GetExitStates() const { return ExitStates; }

private:
	std::array<EState, kMaxRouteLength> EnterStates;
	std::array<EState, kMaxRouteLength> ExitStates;

	size_t ExitEnd = 0;
	size_t EnterEnd = 0;
};

