// PRIVATE CALLBACK API ============================================================================

template <typename T>
bool Gochart<T>::HandleTrigger(EState state, const {{$internal}}::TriggerEntry& trigger_entry)
{
    switch (state)
    {
        {{- range $sc.States }}
        {{- $state := . }}
        case EState::{{$state.Name}}:
            return {{$state.DisplayName}}_HandleTrigger(trigger_entry);
        {{- end }}
        case EState::__Invalid__:
            break;
    }

    GOCHART_DEBUG_BREAK;
    return false;
}

template <typename T>
void Gochart<T>::ProcessTrigger(EState state, const {{$internal}}::TriggerEntry& trigger_entry)
{
    // We go over each state starting from the current to see if they would handle the state.
    while (state != EState::__Invalid__)
    {
        // If this particular state handles the trigger, we stop bubbling up.
        if (HandleTrigger(state, trigger_entry))
        {
            break;
        }
        state = {{$internal}}::GetParentState(state);
    }
}

