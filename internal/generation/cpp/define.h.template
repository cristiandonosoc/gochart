template <typename T>
std::unique_ptr<Gochart<T>> Create(T* owner)
{
	return std::unique_ptr<Gochart<T>>(new Gochart(owner));
}

template <typename T>
bool Gochart<T>::IsInStateExact(EState state) const
{
	// You cannot query for invalid state.
	if (state == EState::__Invalid__)
	{
		return false;
	}


	// Go over all the concurrent groups and check if we're in that state.
	for (EState current_state : CurrentStates)
	{
		if (current_state == state)
		{
			return true;
		}
	}

	return false;
}

template <typename T>
bool Gochart<T>::IsInState(EState state) const
{
	// You cannot query for invalid state.
	if (state == EState::__Invalid__)
	{
		return false;
	}


	// First check if we're explicitly in any leaf state.
	if (IsInStateExact(state))
	{
		return true;
	}

	// Otherwise we need to go over each concurrent group looking for parents.
	for (EState current_state : CurrentStates)
	{
		// Go over the parent states and see if that is the state being asked for.
		current_state = {{$internal}}::GetParentState(current_state);
		while (current_state != EState::__Invalid__)
		{
			if (current_state == state)
			{
				return true;
			}
			current_state = {{$internal}}::GetParentState(current_state);
		}
	}

	return false;
}

// Declare the state reaction data functions.
// These are the ones that have actually the information of which reactions each state has.

// Constructor/Destructor --------------------------------------------------------------------------

template <typename T>
Gochart<T>::Gochart(T* owner) : Owner(owner)
{
	for (size_t i = 0; i < {{$internal}}::kConcurrentGroupCount; i++)
	{
		CurrentStates[i] = EState::__Invalid__;
	}
}

template <typename T>
Gochart<T>::~Gochart()
{
	for (size_t i = 0; i < {{$internal}}::kConcurrentGroupCount; i++)
	{
		assert(CurrentStates[i] == EState::__Invalid__);
	}
}

// Activate/Deactivate -----------------------------------------------------------------------------

template <typename T>
void Gochart<T>::Activate()
{
    assert(!GetFlag_Active());
	for (EState state : CurrentStates)
	{
		assert(state == EState::__Invalid__);
	}

    assert(!GetFlag_Activating());
    SetFlag_Active(true);
    SetFlag_Activating(true);

    // Set the processing state for this operation.
    {{$internal}}::TriggerProcessingState processing_state;
    ProcessingState = &processing_state;

    // As an initialization, we enter the default root state.
    EState default_root = EState::{{$sc.Root.Name}};
    EnterState(default_root, ETrigger::__Invalid__, nullptr);

    // Now we do the default enter for this step.
    ProcessTransition(default_root, default_root, ETrigger::__Invalid__, nullptr);

    ProcessTriggerQueue();

    // Clear the processing state.
    ProcessingState = nullptr;
    SetFlag_Activating(false);
}

template <typename T>
void Gochart<T>::Deactivate()
{
    assert(GetFlag_Active());
	// The root state should be active.
    assert(CurrentStates[0] != EState::__Invalid__);

    assert(!GetFlag_Deactivating());
    SetFlag_Deactivating(true);

    // We process a transition of the root concurrent group to invalid, which means an exit.
    ProcessTransition(CurrentStates[0], EState::__Invalid__, ETrigger::__Invalid__, nullptr);

    SetFlag_Deactivating(false);
    SetFlag_Active(false);

	// Now all states should be exited.
	for (EState state : CurrentStates)
	{
		assert(state == EState::__Invalid__);
	}
}

// Triggers ----------------------------------------------------------------------------------------

{{- range $sc.Triggers }}
{{- $trigger := . }}
{{- $args := $trigger.ArgsStringList | join ", " }}

template <typename T>
void Gochart<T>::Trigger{{$trigger.Name}}({{$args}})
{
    if (!GetFlag_Active() || GetFlag_Deactivating())
    {
        return;
    }

    // Create the data.
    {{$internal}}::{{$trigger.Name}}Data data {
    {{- range $trigger.Args }}
    {{- $arg := . }}
        .{{$arg.Name}} = std::move({{$arg.Name}}),
    {{- end }}
    };

    // Create the entry.
    {{$internal}}::TriggerEntry entry {
        .Trigger = ETrigger::{{$trigger.Name}},
        .Data = std::move(data),
    };

    // Check if we're currently processing a trigger.l
    // If so, we simply queue the event.
    if (ProcessingState)
    {
        ProcessingState->TriggerQueue.Enqueue(std::move(entry));
    }
    else
    {
        // Here it means that we received a trigger from the outside, not as the part of processing
        // another trigger, so we need to create the tracking state.
        {{$internal}}::TriggerProcessingState processing_state;
        ProcessingState = &processing_state;

        // We enqueue the event.
        ProcessingState->TriggerQueue.Enqueue(std::move(entry));

        // We start processing the events.
        ProcessTriggerQueue();

        // We clear it after the event.
        ProcessingState = nullptr;
    }
}

