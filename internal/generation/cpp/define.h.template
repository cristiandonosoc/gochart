template <typename T>
void Gochart<T>::EnterState(EState state, ETrigger trigger, const void* trigger_data)
{
    assert(state != EState::Invalid);
	size_t concurrent_group = {{$privateNamespace}}::GetConcurrentGroup(state);
	assert(concurrent_group < kConcurrentGroupCount);

	CurrentStates[concurrent_group] = state;

    // First we check for trigger specific reactions, as the default one will be called always.
    if (trigger != ETrigger::Invalid && {{$privateNamespace}}::HasEnterReaction(state, trigger))
    {
        assert(trigger_data != nullptr);
        {{$privateNamespace}}::{{$implClassName}}::CallEnterReaction(*this, state, trigger, trigger_data);
    }

    // Now we check if we need to also call the default enter reaction.
    if ({{$privateNamespace}}::HasEnterReaction(state, ETrigger::Invalid))
    {
        {{$privateNamespace}}::{{$implClassName}}::CallEnterReaction(*this, state, ETrigger::Invalid, nullptr);
    }

	// If we have no more children, we know that we are the last enter of this route, so we can
	// evaluate leaf conditions.
	if ({{$privateNamespace}}::GetChildCount(state) == 0)
	{
		EvaluateLeafConditions(state, trigger, trigger_data);
	}
	else
	{
		// Now that we enter, we see if this state is concurrent and we need to enter the other
		// concurrent groups.
		if ({{$privateNamespace}}::GetIsConcurrent(state))
		{
			EvaluateConcurrentEnter(state, trigger, trigger_data);
		}
	}
}

template <typename T>
void Gochart<T>::EvaluateLeafConditions(EState state, ETrigger trigger, const void* trigger_data)
{
	switch (state)
	{
		{{- range $sc.States }}
		{{- $state := . }}
		{{- if gt (len $state.GetNullTransitions) 0 }}
		case EState::{{$state.Name}}:
		{
			assert({{$privateNamespace}}::GetChildCount(state) == 0);

			// We check the null transitions.
			bool handled = false;
			for (EState target_state : {{$privateNamespace}}::kState{{$state.Name}}NullTransitionTargetsArray)
			{
				// Check if this null transition has a condition.
				if (!{{$privateNamespace}}::{{$implClassName}}::State{{$state.Name}}_EvaluateNullTransitionConditionTargeting(*this, target_state))
				{
					continue;
				}

				// Check if this null transition has an embedded action.
				{{$privateNamespace}}::{{$implClassName}}::State{{$state.Name}}_EvaluateNullTransitionActionTargeting(*this, target_state);

				// Trigger immediatelly the transition.
				ProcessTransition(state, target_state, ETrigger::Invalid, nullptr);
				handled = true;
				break;
			}

			if (handled)
			{
				return;
			}

			break;
		}
		{{- end }}{{/* if gt (len $state.GetNullTransitions) 0 */}}
		{{- end }}{{/* range $sc.States */}}
		default:
			break;
	}
}

template <typename T>
void Gochart<T>::EvaluateConcurrentEnter(EState state, ETrigger trigger, const void* trigger_data)
{
	switch (state)
	{
		{{- range $sc.States }}
		{{- $state := . }}
		case EState::{{$state.Name}}:
		{
			{{- if $state.Concurrent }}
			for (EState child_state : {{$privateNamespace}}::kState{{$state.Name}}ChildrenArray)
			{
				// We enter the state and the we trigger a transition to follow the default enters.
				EnterState(child_state, trigger, trigger_data);
				ProcessTransition(child_state, child_state, trigger, trigger_data);
			}
			{{- else }}
			// State {{$state.Name}} is not concurrent. Nothing to do.
			GOCHART_DEBUG_BREAK;
			{{- end }}
			break;
		}
		{{- end }}{{/* range $sc.States */}}
		case EState::Invalid:
			GOCHART_DEBUG_BREAK;
			break;
	}
}

template <typename T>
void Gochart<T>::ExitState(EState state, ETrigger trigger, const void* trigger_data)
{
    assert(state != EState::Invalid);
	size_t concurrent_group = {{$privateNamespace}}::GetConcurrentGroup(state);
	assert(concurrent_group < kConcurrentGroupCount);

	// First we check if we need to exit any of the concurrent children.
	EvaluateConcurrentExit(state, trigger, trigger_data);

    // First we check for a trigger specific exit. Then we call the default exit.
    if (trigger != ETrigger::Invalid && {{$privateNamespace}}::HasExitReaction(state, trigger))
    {
        assert(trigger_data != nullptr);
        {{$privateNamespace}}::{{$implClassName}}::CallExitReaction(*this, state, trigger, trigger_data);
    }

    // Then we call the default exit.
    if ({{$privateNamespace}}::HasExitReaction(state, ETrigger::Invalid))
    {
        {{$privateNamespace}}::{{$implClassName}}::CallExitReaction(*this, state, ETrigger::Invalid, nullptr);
    }

	// If the parent is concurrent, then we mark this concurrent group as invalid (stopped).
    EState parent = {{$privateNamespace}}::GetParentState(state);
	if (parent != EState::Invalid && {{$privateNamespace}}::GetIsConcurrent(parent))
	{
		parent = EState::Invalid;
	}
	CurrentStates[concurrent_group] = parent;
}

template <typename T>
void Gochart<T>::EvaluateConcurrentExit(EState state, ETrigger trigger, const void* trigger_data)
{
	switch (state)
	{
		{{- range $sc.States }}
		{{- $state := . }}
		case EState::{{$state.Name}}:
		{
			{{- if $state.Concurrent }}
			for (EState child_state : {{$privateNamespace}}::kState{{$state.Name}}ChildrenArray)
			{
				// We issue a transition of this state out.
				ProcessTransition(child_state, EState::Invalid, trigger, trigger_data);
			}
			{{- else }}
			// State {{$state.Name}} is not concurrent. Nothing to do.
			{{- end }}
			break;
		}
		{{- end }}{{/* range $sc.States */}}
		case EState::Invalid:
			GOCHART_DEBUG_BREAK;
			break;
	}
}

template <typename T>
void Gochart<T>::CaptureTrigger(EState state, ETrigger trigger, const void* trigger_data)
{
    assert(state != EState::Invalid);

    {{$privateNamespace}}::{{$implClassName}}::CallCaptureReaction(*this, state, trigger, trigger_data);
}

// ProcessTriggerQueue -----------------------------------------------------------------------------

template <typename T>
void Gochart<T>::ProcessTriggerQueue()
{
    assert(GetIsActive());
    assert(ProcessingState != nullptr);

    assert(!GetIsProcessingTriggerQueue());
    SetIsProcessingTriggerQueue(true);

    while (true)
    {
        const auto& entry = ProcessingState->TriggerQueue.GetCurrent();
        if (entry.Trigger == ETrigger::Invalid)
        {
            break;
        }

        ProcessingState->CurrentTrigger = entry.Trigger;

		// We issue the trigger to all current active concurrent states.
		// The order of the concurrent groups is such that child groups will be processed first.
		for (EState state : CurrentStates)
		{
			if (state == EState::Invalid)
			{
				continue;
			}

			{{$privateNamespace}}::{{$implClassName}}::ProcessTrigger(*this, state, entry);
		}

        ProcessingState->TriggerQueue.Dequeue();
    }

    ProcessingState->CurrentTrigger = ETrigger::Invalid;
    SetIsProcessingTriggerQueue(false);
}

// Process Transition ------------------------------------------------------------------------------

template <typename T>
void Gochart<T>::ProcessTransition(EState from, EState to, ETrigger trigger, const void* trigger_data)
{
    // Get the default enter route from this state.
    {{$privateNamespace}}::Route route;
    {{$privateNamespace}}::Route::Compute(from, to, &route);

    // We go over all the exit states for this route.
    for (int i = 0; i < route.GetExitStatesSize(); i++)
    {
        EState state = route.GetExitStates()[i];
        ExitState(state, trigger, trigger_data);
    }

    // We now enter all the states needed for this route.
    for (int i = 0; i < route.GetEnterStatesSize(); i++)
    {
        EState state = route.GetEnterStates()[i];
        EnterState(state, trigger, trigger_data);
    }
}

