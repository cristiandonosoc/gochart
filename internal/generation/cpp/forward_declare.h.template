{{template "header.template" .}}

{{- $root := . -}}
{{- $sc := $root.Gochart }}
{{- $namespace := printf "gochart::%s" $sc.Namespace }}
{{- $internal := "internal" }}

#include <cstdint>

/***************************************************************************************************
 *
 * If you're looking for the signature you must implement for the gochart delegate.
 * Here you go:
{{ $reactionTypes := list "Enter" "Exit" "Capture" }}
{{- range $_, $state := $sc.States }}
{{- range $_, $reactionType := $reactionTypes }}

{{- if $state.HasDefaultReaction $reactionType }}
void {{$state.DisplayName}}_{{$reactionType}}();
{{- end }}

{{- range $_, $trigger := $sc.Triggers }}
{{- if $state.HasReaction $reactionType $trigger }}
{{- $args := $trigger.ArgsStringList | join ", " }}
void {{$state.DisplayName}}_{{$reactionType}}{{$trigger.Name}}({{$args}});
{{- end }}
{{- end }}{{/* range $sc.Triggers */}}

{{- end }}{{/* range $reactionTypes */}}
{{- end }}{{/* range $sc.States */}}

 *
 **************************************************************************************************/

namespace {{$namespace}}
{

template <typename T>
class Gochart;	// Forward declare.

// TODO(cdc): Automatically expand this to uint16 if ever need more than 254 triggers.
enum class ETrigger : uint8_t
{
	__Invalid__,
	{{- range $sc.Triggers }}
	{{.Name}},
	{{- end }}
};
const char* ToString(ETrigger trigger);

// TODO(cdc): Automatically expand this to uint16 if ever need more than 254 states.
enum class EState : uint8_t
{
	__Invalid__,
	{{- range $sc.States}}
	{{.Name}},
	{{- end}}
};
const char* ToString(EState state);

} // namespace {{$namespace}}

{{template "footer.template" . }}
