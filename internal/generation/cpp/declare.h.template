{{template "header.template" .}}

{{- $root := . -}}
{{- $sc := $root.Gochart }}
{{- $namespace := printf "gochart::%s" $sc.Namespace }}
{{- $internal := "internal" }}

#include "{{$root.ForwardDeclareInclude}}"

#include <array>
#include <bitset>
#include <cstddef>
#include <memory>

namespace {{$namespace}}
{

namespace {{$internal}}
{

struct TriggerEntry; // Forward declare.
struct TriggerProcessingState; // Forward declare.

constexpr size_t kParallelGroupCount = {{$sc.ParallelGroupCount}};

} // namespace {{$internal}}

template <typename T>
std::unique_ptr<Gochart<T>> Create(T* owner);

// Gochart -----------------------------------------------------------------------------------------

template <typename T>
class Gochart
{
public:
	using ParallelGroupStateArray = std::array<EState, {{$internal}}::kParallelGroupCount>;

public:
    Gochart(T* owner);
    ~Gochart();

    void Activate();
    void Deactivate();

    T& GetOwner() { return *Owner; }
	const T& GetOwner() const { return *Owner; }

	// IsInStateExact will go over all the active parallel group and check whether it is currently
	// in the required state. It will not consider parent states.
	bool IsInStateExact(EState state) const;

	// IsInState is like |IsInStateExact|, only that it will also check the parent states.
	bool IsInState(EState state) const;

	const ParallelGroupStateArray& GetCurrentStates() const { return CurrentStates; }

public:
    // **** TRIGGER API BEGIN ****
    {{- range $sc.Triggers }}
    {{- $trigger := . }}
    {{- $args := $trigger.ArgsStringList | join ", " }}
    {{- $argsNames := $trigger.ArgsNameList | join ", " }}
    void Trigger{{$trigger.Name}}({{$args}});
    {{- end }}
    // **** TRIGGER API END ****

public:
	Gochart() = default;

private:
	// No copy construction.
	Gochart(const Gochart&) = delete;
	Gochart& operator=(const Gochart&) = delete;

	// No move construction.
	Gochart(Gochart&&) = delete;
	Gochart& operator=(Gochart&&) = delete;

private:
	// Functional runtime.
    void EnterState(EState state, ETrigger trigger, const void* trigger_data);
	void EvaluateLeafConditions(EState state, ETrigger trigger, const void* trigger_data);
	void EvaluateParallelEnter(EState state, ETrigger trigger, const void* trigger_data);
    void ExitState(EState state, ETrigger trigger, const void* trigger_data);
	void EvaluateParallelExit(EState state, ETrigger trigger, const void *trigger_data);
    void CaptureTrigger(EState state, ETrigger trigger, const void* trigger_data);
    void ProcessTriggerQueue();
    void ProcessTransition(EState from, EState to, ETrigger trigger, const void* trigger_data);

private:
	// **** PRIVATE CALLBACK API BEGIN ****

	bool HandleTrigger(EState state, const {{$internal}}::TriggerEntry& trigger_entry);
	void ProcessTrigger(EState state, const {{$internal}}::TriggerEntry& trigger_entry);

	{{- range $sc.States }}
		{{- $state := . }}

		bool {{$state.DisplayName}}_HandleTrigger(const {{$internal}}::TriggerEntry& trigger_entry);
		bool {{$state.DisplayName}}_EvaluateNullTransitionConditionTargeting(EState target_state) const;
		void {{$state.DisplayName}}_EvaluateNullTransitionActionTargeting(EState target_state);

		{{- range $state.GetNullTransitions }}
			{{- $nullTransition := . }}
			{{- if $nullTransition.HasCondition }}
				bool {{$state.DisplayName}}_EvaluateNullTransitionConditionTargeting{{$nullTransition.To.Name}}() const;
			{{- end }}{{/* if $nullTransition.HasCondition */}}
			{{- if $nullTransition.HasAction }}
				void {{$state.DisplayName}}_EvaluateNullTransitionActionTargeting{{$nullTransition.To.Name}}();
			{{- end }}{{/* if $nullTransition.HasAction */}}
		{{- end }}{{/* range $state.GetNullTransitions */}}

		{{- range $sc.Triggers }}
			{{- $trigger := . }}
			{{- if $state.HasTransition $trigger }}
				{{- $transition := $state.GetTransition $trigger }}
				{{- if $transition.HasCondition }}
					{{- $args := $trigger.ArgsStringList | join ", " }}
					bool {{$state.DisplayName}}_EvaluateTransitionConditionFor{{$trigger.Name}}({{$args}}) const;
				{{- end }}{{/* if $transition.HasCondition */}}

				{{- if $transition.HasAction }}
					{{- $args := $trigger.ArgsStringList | join ", " }}
					void {{$state.DisplayName}}_ExecuteActionFor{{$trigger.Name}}({{$args}});
				{{- end }}{{/* if $transition.HasAction */}}
			{{- end }}{{/* $state.HasTransition */}}

			{{- if $state.HasCapture $trigger }}
				{{- $capture := $state.GetCapture $trigger }}
				{{- if $capture.HasCondition }}
					{{- $args := $trigger.ArgsStringList | join ", " }}
					bool {{$state.DisplayName}}_EvaluateCaptureConditionFor{{$trigger.Name}}({{$args}}) const;
				{{- end }}{{/* if $capture.HasCondition */}}
			{{- end }}{{/* if $state.HasCapture $trigger */}}
		{{- end }}{{/* range $sc.Triggers */}}

	{{- end }}{{/* range $sc.States */}}

	{{/****** STATE REACTIONS *******************************************************************/}}

	{{- $reactionTypes := list "Enter" "Exit" "Capture" }}
	{{- range $reactionTypes }}
		{{- $reactionType := . }}
		void Call{{$reactionType}}Reaction(EState state, ETrigger trigger, const void* trigger_data);
		{{- range $sc.States }}
			{{- $state := . }}
			void {{$state.DisplayName}}_Call{{$reactionType}}Reaction(ETrigger trigger, const void* trigger_data);
		{{- end }}{{/* range $sc.States */}}
	{{- end }}{{/* range $reactionTypes */}}

	// **** PRIVATE CALLBACK API END ****

private:
    {{$internal}}::TriggerProcessingState* ProcessingState = nullptr;
    T* Owner = nullptr;
	ParallelGroupStateArray CurrentStates;
    // State tracking flags.
    std::bitset<8> StateFlags;

#define GOCHART_DEFINE_STATE_FLAG(name, index) \
public: \
    bool GetFlag_##name() const { return StateFlags.test(index); } \
private: \
    void SetFlag_##name(bool active) { StateFlags[index] = active; }

    GOCHART_DEFINE_STATE_FLAG(Active, 0);
    GOCHART_DEFINE_STATE_FLAG(Activating, 1);
    GOCHART_DEFINE_STATE_FLAG(Deactivating, 2);
    GOCHART_DEFINE_STATE_FLAG(ProcessingTriggerQueue, 3);

#undef GOCHART_DEFINE_STATE_FLAG
};

} // namespace {{$namespace}}

{{template "footer.template" . }}
