// TriggerRingBufferQueue keeps a queue of all the current triggers active at a given time.
// This is useful because triggers can be sent while handling other triggers, so we need a queue to
// be able to maitain the list of all sent triggers.
//
// TODO(cdc): This class is the same for each statechart class, so there is no need to generate
//            it over and over. Once we have a place to have common "gochart" things, we can
//            move this there.
class TriggerRingBufferQueue
{
public:
    // TODO(cdc): Make queue size configurable.
    static constexpr size_t kRingBufferSize = 16;

public:
    void Enqueue(TriggerEntry&& entry);
    void Dequeue();

    bool IsEmpty() const { return ReadIndex == WriteIndex; }
    bool IsFull() const { return ((WriteIndex + 1) % kRingBufferSize ) == ReadIndex; }

public:
    const TriggerEntry& GetCurrent() const { return RingBuffer[ReadIndex]; }

private:
    std::array<TriggerEntry, kRingBufferSize> RingBuffer;
    std::size_t ReadIndex = 0;
    std::size_t WriteIndex = 0;
};

struct TriggerProcessingState
{
    TriggerRingBufferQueue TriggerQueue;
    ETrigger CurrentTrigger = ETrigger::Invalid;
};

