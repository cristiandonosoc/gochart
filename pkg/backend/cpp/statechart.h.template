// Enter/Exit/Capture ------------------------------------------------------------------------------

template <typename T>
void {{$impl}}<T>::EnterState(EState state, ETrigger trigger, const void* trigger_data)
{
    assert(state != EState::Invalid);
	size_t concurrent_group = GetConcurrentGroup(state);
	assert(concurrent_group < kConcurrentGroupCount);

	CurrentStates[concurrent_group] = state;

    // First we check for trigger specific reactions, as the default one will be called always.
    if (trigger != ETrigger::Invalid && HasEnterReaction(state, trigger))
    {
        assert(trigger_data != nullptr);
        CallEnterReaction(*this, state, trigger, trigger_data);
    }

    // Now we check if we need to also call the default enter reaction.
    if (HasEnterReaction(state, ETrigger::Invalid))
    {
        CallEnterReaction(*this, state, ETrigger::Invalid, nullptr);
    }

	// Now that we enter, we see if this state is concurrent and we need to enter the other
	// concurrent groups.
	EvaluateConcurrentEnter(state, trigger, trigger_data);
}

template <typename T>
void {{$impl}}<T>::EvaluateConcurrentEnter(EState state, ETrigger trigger, const void* trigger_data)
{
	switch (state)
	{
		{{- range $sc.States }}
		{{- $state := . }}
		case EState::{{$state.Name}}:
		{
			{{- if $state.Concurrent }}
			for (EState child_state : kState{{$state.Name}}ChildrenArray)
			{
				// We enter the state and the we trigger a transition to follow the default enters.
				EnterState(child_state, trigger, trigger_data);
				ProcessTransition(child_state, child_state, trigger, trigger_data);
			}
			{{- else }}
			// State {{$state.Name}} is not concurrent. Nothing to do.
			{{- end }}
			break;
		}

		{{- end }}{{/* range $sc.States */}}
	}
}

template <typename T>
void {{$impl}}<T>::ExitState(EState state, ETrigger trigger, const void* trigger_data)
{
    assert(state != EState::Invalid);
	size_t concurrent_group = GetConcurrentGroup(state);
	assert(concurrent_group < kConcurrentGroupCount);

	// First we check if we need to exit any of the concurrent children.
	EvaluateConcurrentExit(state, trigger, trigger_data);

    // First we check for a trigger specific exit. Then we call the default exit.
    if (trigger != ETrigger::Invalid && HasExitReaction(state, trigger))
    {
        assert(trigger_data != nullptr);
        CallExitReaction(*this, state, trigger, trigger_data);
    }

    // Then we call the default exit.
    if (HasExitReaction(state, ETrigger::Invalid))
    {
        CallExitReaction(*this, state, ETrigger::Invalid, nullptr);
    }

	// If the parent is concurrent, then we mark this concurrent group as invalid (stopped).
    EState parent = GetParentState(state);
	if (parent != EState::Invalid && GetIsConcurrent(parent))
	{
		parent = EState::Invalid;
	}
	CurrentStates[concurrent_group] = parent;
}

template <typename T>
void {{$impl}}<T>::EvaluateConcurrentExit(EState state, ETrigger trigger, const void* trigger_data)
{
	switch (state)
	{
		{{- range $sc.States }}
		{{- $state := . }}
		case EState::{{$state.Name}}:
		{
			{{- if $state.Concurrent }}
			for (EState child_state : kState{{$state.Name}}ChildrenArray)
			{
				// We issue a transition of this state out.
				ProcessTransition(child_state, EState::Invalid, trigger, trigger_data);
			}
			{{- else }}
			// State {{$state.Name}} is not concurrent. Nothing to do.
			{{- end }}
			break;
		}
		{{- end }}{{/* range $sc.States */}}
	}
}

