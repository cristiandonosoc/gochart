template <typename T>
void {{$impl}}<T>::Activate()
{
    assert(!GetIsActive());
	for (EState state : CurrentStates)
	{
		assert(state == EState::Invalid);
	}

    assert(!GetIsActivating());
    SetIsActive(true);
    SetIsActivating(true);

    // Set the processing state for this operation.
    TriggerProcessingState processing_state;
    ProcessingState = &processing_state;

    // As an initialization, we enter the default root state.
    EState default_root = EState::{{$sc.DefaultRootState.Name}};
    EnterState(default_root, ETrigger::Invalid, nullptr);

    // Now we do the default enter for this step.
    ProcessTransition(default_root, default_root, ETrigger::Invalid, nullptr);

    ProcessTriggerQueue();

    // Clear the processing state.
    ProcessingState = nullptr;
    SetIsActivating(false);
}

template <typename T>
void {{$impl}}<T>::Deactivate()
{
    assert(GetIsActive());
	// The root state should be active.
    assert(CurrentStates[0] != EState::Invalid);

    assert(!GetIsDeactivating());
    SetIsDeactivating(true);

    // We process a transition of the root concurrent group to invalid, which means an exit.
    ProcessTransition(CurrentStates[0], EState::Invalid, ETrigger::Invalid, nullptr);

    SetIsDeactivating(false);
    SetIsActive(false);

	// Now all states should be exited.
	for (EState state : CurrentStates)
	{
		assert(state == EState::Invalid);
	}
}

