bool State{{$state.Name}}_HandleTrigger({{$impl}}* impl, const TriggerEntry& trigger_entry)
{
    switch (trigger_entry.Trigger)
    {
        {{- range $sc.Triggers }}
        {{- $trigger := . }}
        case {{$triggerEnum}}::{{$trigger.Name}}:
            {{- if $state.HasTransitionFor $trigger }}
            {{- $transition := $state.GetTransitionFor $trigger }}
            {
                // Get the trigger data.
                const auto& data = std::get<{{$trigger.Name}}Data>(trigger_entry.Data);
                impl->ProcessTransition({{$stateEnum}}::{{$transition.From.Name}},
                                        {{$stateEnum}}::{{$transition.To.Name}},
                                        {{$triggerEnum}}::{{$transition.Trigger.Name}},
                                        &data);
                return true;
            }
						{{- else if $state.HasCapture $trigger }}
						{
                // Get the trigger data.
                const auto& data = std::get<{{$trigger.Name}}Data>(trigger_entry.Data);
								impl->CaptureTrigger({{$stateEnum}}::{{$state.Name}}, {{$triggerEnum}}::{{$trigger.Name}}, &data);
						}
            {{- else }}
            // State {{$state.Name}} doesn't handle trigger {{$trigger.Name}}.
            return false;
            {{- end }}
        {{- end }}
        case {{$triggerEnum}}::Invalid:
            break;
    }

    GOCHART_DEBUG_BREAK;
    return false;
}

{{- end }}

bool HandleTrigger({{$impl}}* impl, {{$stateEnum}} state, const TriggerEntry& trigger_entry)
{
    switch (state)
    {
        {{- range $sc.States }}
        {{- $state := . }}
        case {{$stateEnum}}::{{$state.Name}}:
            return State{{$state.Name}}_HandleTrigger(impl, trigger_entry);
        {{- end }}
        case {{$stateEnum}}::Invalid:
            break;
    }

    GOCHART_DEBUG_BREAK;
    return false;
}

void ProcessTrigger({{$impl}}* impl, {{$stateEnum}} state, const TriggerEntry& trigger_entry)
{
    // We go over each state starting from the current to see if they would handle the state.
    while (state != {{$stateEnum}}::Invalid)
    {
        // If this particular state handles the trigger, we stop bubbling up.
        if (HandleTrigger(impl, state, trigger_entry))
        {
            break;
        }
        state = GetParentState(state);
    }
}

} // namespace {{$impl}}_private

void {{$impl}}::ProcessTriggerQueue()
{
    assert(GetIsActive());
    assert(ProcessingState != nullptr);

    assert(!GetIsProcessingTriggerQueue());
    SetIsProcessingTriggerQueue(true);

    while (true)
    {
        const auto& entry = ProcessingState->TriggerQueue.GetCurrent();
        if (entry.Trigger == {{$triggerEnum}}::Invalid)
        {
            break;
        }

        ProcessingState->CurrentTrigger = entry.Trigger;
        ProcessTrigger(this, CurrentState, entry);

        ProcessingState->TriggerQueue.Dequeue();
    }

    ProcessingState->CurrentTrigger = {{$triggerEnum}}::Invalid;
    SetIsProcessingTriggerQueue(false);
}

// Process Transition ------------------------------------------------------------------------------

void {{$impl}}::ProcessTransition({{$stateEnum}} from, {{$stateEnum}} to, {{$triggerEnum}} trigger, const void* trigger_data)
{
    using namespace {{$impl}}_private;

    // Get the default enter route from this state.
    Route route;
    ComputeRoute(from, to, &route);

    // We go over all the exit states for this route.
    for (int i = 0; i < route.GetExitStatesSize(); i++)
    {
        {{$stateEnum}} state = route.GetExitStates()[i];
        ExitState(state, trigger, trigger_data);
    }

    // We now enter all the states needed for this route.
    for (int i = 0; i < route.GetEnterStatesSize(); i++)
    {
        {{$stateEnum}} state = route.GetEnterStates()[i];
        EnterState(state, trigger, trigger_data);
    }
}

// Route Implementation ----------------------------------------------------------------------------

namespace {{$impl}}_private
{

Route::Route()
{
    // We ensure that the route are filled with invalid.
    for (size_t i = 0; i < kMaxRouteLength; i++)
    {
        EnterStates[i] = {{$stateEnum}}::Invalid;
        ExitStates[i] = {{$stateEnum}}::Invalid;
    }
}

void Route::AppendEnterState({{$stateEnum}} enter)
{
    assert(EnterEnd < kMaxRouteLength);
    EnterStates[EnterEnd++] = enter;
}

void Route::AppendExitState({{$stateEnum}} exit)
{
    assert(ExitEnd < kMaxRouteLength);
    ExitStates[ExitEnd++] = exit;
}

void Route::SwapEnterStates()
{
    // We swap the enter states in so they in the furthers from the |from| state first.
    for (size_t i = 0; i <= EnterEnd; i++)
    {
        std::swap(EnterStates[i], EnterStates[EnterEnd - i]);
    }
}

void Route::AppendDefaultEnters({{$stateEnum}} state, Route* out)
{
    {{$stateEnum}} default_child = GetDefaultChild(state);
    while (default_child != {{$stateEnum}}::Invalid)
    {
        out->AppendEnterState(default_child);
        default_child = GetDefaultChild(default_child);
    }
}

void Route::AppendDefaultExits({{$stateEnum}} state, Route* out)
{
    while (state != {{$stateEnum}}::Invalid)
    {
        out->AppendExitState(state);
        state = GetParentState(state);
    }
}

void ComputeRoute({{$stateEnum}} from, {{$stateEnum}} to, Route* out)
{
    using namespace {{$impl}}_private;

    assert(from != {{$stateEnum}}::Invalid);

    // Special case of when we are just entering a state without a target.
    // The main case is when activating the statechart, in which we enter the root state.
    if (to == {{$stateEnum}}::Invalid)
    {
        out->AppendDefaultExits(from, out);
        return;
    }

    {{$stateEnum}} original_to = to;

    // We need to find the common state between them.
    // Since they are not the same, first we go from the |from|, compare, and then we compare
    // from the |to|. If not equal then, repeat the process.
    while (from != to)
    {
        // Try to go up from the |from| side.
        if ({{$stateEnum}} from_parent = GetParentState(from); from_parent != {{$stateEnum}}::Invalid)
        {
            out->AppendExitState(from);
            from = from_parent;
        }

        // Now that we went up on |from|, we check if now we are in the same state.
        if (from == to)
        {
            // If this case happened, we need to also enter the state we just popped from.
            out->AppendEnterState(to);
            break;
        }

        // Now we pop the |to| side.
        if ({{$stateEnum}} to_parent = GetParentState(to); to_parent != {{$stateEnum}}::Invalid)
        {
            out->AppendEnterState(to);
            to = to_parent;
        }

        // At this point we're ready to try again.
    }

    // Now it could be that the destination state is not a leaf state, so we get the default enters.
    out->AppendDefaultEnters(original_to, out);

    // We need to reverse the valid enter states, as they are in the wrong order.
    out->SwapEnterStates();
}

} // namespace {{$impl}}_private


// TriggerRingBufferQueue Implementation -----------------------------------------------------------

namespace {{$impl}}_private
{

void TriggerRingBufferQueue::Enqueue(TriggerEntry&& entry)
{
    assert(!IsFull());
    RingBuffer[WriteIndex] = std::move(entry);
    WriteIndex = (WriteIndex + 1) % kRingBufferSize;
}

void TriggerRingBufferQueue::Dequeue()
{
    assert(!IsEmpty());

    RingBuffer[ReadIndex] = {};  // Clear the entry.
    ReadIndex = (ReadIndex + 1) % kRingBufferSize ;
}

} // namespace {{$impl}}_private

} // namespace gochart

#undef GOCHART_DEBUG_BREAK
