gochart Parallel {
	trigger SomeTrigger()

	state A {
		state B {
			state D(parallel) {
				state H {
					capture SomeTrigger
				}

				state I {
					capture SomeTrigger
				}
			}
		}

		state C(parallel) {
			state E {
				state J {
					capture SomeTrigger
				}

				state K {
					capture SomeTrigger
				}
			}

			state F(parallel) {
				state L {
					capture SomeTrigger
				}

				state M {
					capture SomeTrigger
				}
			}

			state G {
				state N {
					capture SomeTrigger
				}

				state O {
					capture SomeTrigger
				}
			}
		}
	}
}
