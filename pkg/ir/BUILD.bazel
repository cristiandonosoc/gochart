load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ir",
    srcs = [
        "cpp.go",
        "input.go",
        "ir.go",
        "options.go",
        "printer.go",
        "test_utils.go",
        "validator.go",
    ],
    importpath = "github.com/cristiandonosoc/gochart/pkg/ir",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/errors",
        "//internal/printer",
        "//pkg/frontend/common",
        "@com_github_cristiandonosoc_golib//pkg/files",
        "@com_github_stretchr_testify//assert",
    ],
)

go_test(
    name = "ir_test",
    srcs = [
        "cpp_test.go",
        "input_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":ir"],
    deps = [
        "//pkg/frontend/common",
        "//pkg/frontend/gochart_lang",
        "//pkg/frontend/yaml",
        "@com_github_cristiandonosoc_golib//pkg/files",
        "@com_github_cristiandonosoc_golib//pkg/test_support",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
