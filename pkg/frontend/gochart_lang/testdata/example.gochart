statechart Example {
	trigger Execute()
	trigger Update(float dt)
	trigger SomeMessage(const hvn::Message* message, int other, const std::string& another)

	state First {
		enter
		enter Third

		exit
		exit Third

		transition null > Third
		transition Execute > Second
	}

	state Second(Option1) {
		transition Execute > First
	}

	state Third(Opt1, Opt2, Opt3 = Identifier, Opt4 = "String", Opt5 = 2123, Opt6 = true, Opt7 = false, Opt8=22) {
		transition SomeMessage > Second

		state ThirdChild1(OptChild1, OptChild2 = IdentifierChild) {
			state ThirdGrandChild(OptGrandChild = false) {
				transition Execute > Second

				enter
				exit Update
			}
		}

		state ThirdChild2 {
			transition null > ThirdGrandChild
		}
	}
}
