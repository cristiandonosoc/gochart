load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "gochart_lang",
    srcs = [
        "gochart_lang.go",
        "lexer.go",
        "parser.go",
        "scanner.go",
        "translation.go",
    ],
    importpath = "github.com/cristiandonosoc/gochart/pkg/frontend/gochart_lang",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/errors",
        "//internal/option",
        "//pkg/frontend/common",
        "@com_github_cristiandonosoc_golib//pkg/files:go_default_library",
    ],
)

go_test(
    name = "gochart_lang_test",
    srcs = [
        "parser_test.go",
        "scanner_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":gochart_lang"],
    deps = [
        "//internal/test_support",
        "//pkg/frontend/common",
        "@com_github_cristiandonosoc_golib//pkg/files:go_default_library",
        "@com_github_stretchr_testify//assert",
        "@com_github_stretchr_testify//require",
    ],
)
